{
  "version": 1,
  "hooks": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"${COPILOT_HOME:-$HOME/.copilot}/hooks/copilot_transcript.py\"",
        "cwd": ".",
        "timeout": 30
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "python3 \"${COPILOT_HOME:-$HOME/.copilot}/hooks/copilot_transcript.py\"",
        "cwd": ".",
        "timeout": 30
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "python3 \"${COPILOT_HOME:-$HOME/.copilot}/hooks/copilot_transcript.py\"",
        "cwd": ".",
        "timeout": 30
      }
    ]
  }
}
